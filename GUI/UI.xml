<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Script file="Dialogs.lua" />
    <Script file="Tips.lua" />
    <Script file="VersionButton.lua" />
    <Script file="SettingsButton.lua" />
    <Script file="CharactersButton.lua" />
    <Script file="TrackingButton.lua" />
    <Script file="TableRows.lua" />
    <Script file="Main.lua" />

    <Button name="WeeklyRewardsVersionButton" mixin="WeeklyRewardsVersionButtonMixin" hidden="true">
        <Size y="10" />
        <HighlightTexture atlas="questlog-quest-glow-yellow" alphaMode="ADD" />
        <NormalFont style="GameFontDisable" />
        <HighlightFont style="GameFontHighlight" />
        <Scripts>
            <OnLoad method="OnLoad" />
        </Scripts>
    </Button>

    <DropdownButton name="WeeklyRewardsSettingsButtonTemplate" mixin="WeeklyRewardsSettingsButtonMixin" virtual="true">
        <Size x="30" y="30" />
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" atlas="GM-icon-settings">
                    <Size x="30" y="30" />
                    <Anchors>
                        <Anchor point="CENTER" />
                    </Anchors>
                    <Color r="0.7" g="0.7" b="0.7" a="1" />
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture parentKey="Notification" atlas="UI-HUD-MicroMenu-Communities-Icon-Notification" hidden="true">
                    <Size x="15" y="15" />
                    <Anchors>
                        <Anchor point="CENTER" y="-13" />
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad method="OnLoad" />
            <OnEnter method="OnEnter" />
            <OnLeave method="OnLeave" />
        </Scripts>
    </DropdownButton>

    <DropdownButton name="WeeklyRewardsCharactersButtonTemplate" inherits="WeeklyRewardsSettingsButtonTemplate" mixin="WeeklyRewardsCharactersButtonMixin" virtual="true">
        <KeyValues>
            <KeyValue key="iconAtlas" value="squad_size_trios" type="string" />
            <KeyValue key="iconWidth" value="18" type="number" />
        </KeyValues>
    </DropdownButton>

    <DropdownButton name="WeeklyRewardsTrackingButtonTemplate" inherits="WeeklyRewardsSettingsButtonTemplate" mixin="WeeklyRewardsTrackingButtonMixin" virtual="true">
        <KeyValues>
            <KeyValue key="iconAtlas" value="UI-HUD-Minimap-Tracking-Up" type="string" />
            <KeyValue key="iconWidth" value="15" type="number" />
            <KeyValue key="iconHeight" value="14" type="number" />
            <KeyValue key="flag" value="rewards" type="string" />
        </KeyValues>
    </DropdownButton>
</Ui>